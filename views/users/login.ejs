<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <h1 class="col-6 offset-3 heading">Login</h1>
     <hr>
     <br> <br>
  <div class="col-6 offset-3 signup-form">
    <form method="POST" action="/login" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label"><b>Username</b></label>
        <input
          name="username"
          type="text"
          class="form-control"
          id="username"
          required
        />
      </div>

      <div class="mb-3">
        <label for="password" class="form-label"><b>Password</b></label>
        <input
          name="password"
          type="password"
          class="form-control"
          id="password"
          required
        />
     <br>
      <button type="submit" class="btn btn-primary">Login</button>
      <br>
      <br>
      <b>Don't have an account? <a href="/signup">Sign up here</a></b>
      
    </form>
  
    <br> 
  </div>

</div>
